# Striker — Fast Ground Assault Mech
# Role: Hit-and-run combat. Twin autocannons + Afterburner speed boost.
# The Afterburner engages automatically when enemies are within range,
# boosting speed by 67% for aggressive pursuit or rapid disengagement.

type: mech
name: Striker

description: "A highly mobile combat mech with twin rapid-fire autocannons and an afterburner system. When enemies are detected nearby, the afterburner engages automatically, boosting speed by 67%. Built for devastating hit-and-run tactics."

health: 400
armor: 2
speed: 2.4
hitSize: 10
rotateSpeed: 6
itemCapacity: 0

# Mech tuning — aggressive combat stance
mechStepParticles: true
mechFrontSway: 0.5
mechSideSway: 0.6
baseRotateSpeed: 4.0

# Ground only
flying: false
canBoost: false

# Acceleration — responsive for combat maneuvers
accel: 0.1
drag: 0.04

weapons: [
  # ═══════════════════════════════════════════
  # PRIMARY: Twin Autocannons (mirrored)
  # Damage 18, Reload 12 ticks, Range ~24 blocks
  # ═══════════════════════════════════════════
  {
    name: striker-autocannon
    x: 5
    y: 1
    shootY: 3
    reload: 12
    recoil: 1.5
    rotate: false
    mirror: true
    alternate: true
    ejectEffect: casing1
    shootSound: shoot

    bullet: {
      type: BasicBulletType
      speed: 6
      damage: 18
      width: 7
      height: 9
      lifetime: 32
      # Range ≈ speed(6) × lifetime(32) = 192 world units ≈ 24 blocks
      shootEffect: shootSmall
      smokeEffect: shootSmallSmoke
      hitEffect: hitBulletSmall
      despawnEffect: hitBulletSmall
    }
  }
]

# ═══════════════════════════════════════════
# AFTERBURNER: StatusFieldAbility
# Continuously applies a 67% speed boost to the Striker itself.
# Range 1 ensures only this unit is affected.
# ═══════════════════════════════════════════
abilities: [
  {
    type: StatusFieldAbility
    effect: {
      name: afterburner
      speedMultiplier: 1.67
      damageMultiplier: 1.0
      damage: 0
      color: "ff8c00"
    }
    duration: 120
    reload: 60
    range: 1
  }
]

# Research tree placement
research: velocity-protocol-reborn-velocity-ground-factory

